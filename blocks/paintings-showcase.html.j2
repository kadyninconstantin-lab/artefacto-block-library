{# paintings-showcase. items: [{image_url, image_alt, title, text, orientation}]. min=2, max=6.
   Per design rule R8 (visual primacy) + R9 (orientation-aware): each lesson is a full-width section,
   image is large (≥60% viewport on desktop). Vertical paintings → image | text side-by-side on
   desktop. Horizontal paintings → image above, text below. Mobile: always image-then-text stacked. #}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Source+Serif+4:ital,wght@0,400;0,600;0,700;1,400&display=swap">
<!-- Artefacto Block: Paintings Showcase — последовательные секции картина+подпись -->
<style>

    .af-paintings {
        --af-primary: #de6518;
        --af-bg: #f4efe9;
        --af-text: #3b3b3b;
        --af-text-light: #4a4a4a;
        --af-radius: 12px;
        --af-font-heading: 'Source Serif 4', 'Georgia', serif;
        --af-font-body: 'Manrope', 'Helvetica Neue', sans-serif;

        background: var(--af-bg);
        padding: clamp(48px, 7vw, 96px) clamp(16px, 4vw, 48px);
        font-family: var(--af-font-body);
        color: var(--af-text);
    }

    .af-paintings__inner {
        max-width: 1280px;
        margin: 0 auto;
    }

    .af-paintings__heading {
        font-family: var(--af-font-heading);
        font-size: clamp(28px, 4vw, 44px);
        font-weight: 700;
        text-align: center;
        margin-bottom: clamp(40px, 6vw, 80px);
        line-height: 1.2;
    }

    .af-paintings__lesson {
        margin-bottom: clamp(56px, 8vw, 112px);
    }

    .af-paintings__lesson:last-child {
        margin-bottom: 0;
    }

    .af-paintings__image-wrap {
        position: relative;
        border-radius: var(--af-radius);
        overflow: hidden;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.10);
        background: #fff;
    }

    .af-paintings__image {
        display: block;
        width: 100%;
        height: auto;
    }

    .af-paintings__title {
        font-family: var(--af-font-heading);
        font-size: clamp(22px, 2.6vw, 30px);
        font-weight: 700;
        line-height: 1.25;
        margin: 0 0 clamp(12px, 1.5vw, 18px) 0;
    }

    .af-paintings__text {
        font-size: clamp(16px, 1.4vw, 18px);
        line-height: 1.65;
        color: var(--af-text-light);
        margin: 0;
        text-indent: 1.5em;
    }

    /* Horizontal paintings (landscape): image full-width above, text below.
       Mobile uses this same stacked layout regardless of orientation. */
    .af-paintings__lesson--horizontal {
        display: grid;
        grid-template-columns: 1fr;
        gap: clamp(20px, 2.5vw, 32px);
    }

    .af-paintings__lesson--horizontal .af-paintings__text-wrap {
        max-width: 820px;
        margin: 0 auto;
        text-align: center;
    }

    .af-paintings__lesson--horizontal .af-paintings__text {
        text-align: left;
    }

    /* Vertical paintings (portrait, desktop): side-by-side image | text */
    .af-paintings__lesson--vertical {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: clamp(20px, 3vw, 40px);
    }

    @media (min-width: 769px) {
        .af-paintings__lesson--vertical {
            grid-template-columns: minmax(0, 5fr) minmax(0, 4fr);
            align-items: start;
        }

        /* Alternate left/right placement: even-indexed lessons get image on the right */
        .af-paintings__lesson--vertical:nth-of-type(even) .af-paintings__image-wrap {
            order: 2;
        }
    }

    /* Mobile: always stack image above text (override any side-by-side) */
    @media (max-width: 768px) {
        .af-paintings__lesson--vertical {
            grid-template-columns: 1fr;
        }

        .af-paintings__lesson--vertical .af-paintings__text-wrap {
            text-align: center;
        }

        .af-paintings__lesson--vertical .af-paintings__text {
            text-align: left;
        }
    }

    *:focus-visible {
      outline: 3px solid var(--af-primary, #de6518);
      outline-offset: 3px;
      border-radius: 4px;
    }
</style>

<section class="af-paintings">
    <div class="af-paintings__inner">
        <h2 class="af-paintings__heading">What you'll learn</h2>
        {% for item in items %}
        {% set orient = item.orientation | default('horizontal') %}
        <div class="af-paintings__lesson af-paintings__lesson--{{ orient }}">
            {% if orient == 'horizontal' %}
            <div class="af-paintings__text-wrap">
                <h3 class="af-paintings__title">{{ item.title }}</h3>
                <p class="af-paintings__text">{{ item.text }}</p>
            </div>
            {% endif %}
            <div class="af-paintings__image-wrap">
                <img class="af-paintings__image"
                     src="{{ item.image_url }}"
                     alt="{{ item.image_alt | default(item.title) }}"
                     loading="lazy">
            </div>
            {% if orient != 'horizontal' %}
            <div class="af-paintings__text-wrap">
                <h3 class="af-paintings__title">{{ item.title }}</h3>
                <p class="af-paintings__text">{{ item.text }}</p>
            </div>
            {% endif %}
        </div>
        {% endfor %}
    </div>
</section>
