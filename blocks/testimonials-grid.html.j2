{# testimonials-grid. items: [{quote, name, role, avatar_src, avatar_alt}] #}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Source+Serif+4:ital,wght@0,400;0,600;0,700;1,400&display=swap">
<!-- Artefacto Block: Testimonials Grid — отзывы сеткой 2 колонки -->
<style>

    .af-testgrid {
        --af-primary: #de6518;
        --af-bg: #f4efe9;
        --af-card-bg: #ffffff;
        --af-text: #3b3b3b;
        --af-text-light: #4a4a4a;
        --af-radius: 16px;
        --af-font-heading: 'Source Serif 4', 'Georgia', serif;
        --af-font-body: 'Manrope', 'Helvetica Neue', sans-serif;

        background: var(--af-bg);
        padding: clamp(56px, 10vw, 120px) clamp(16px, 4vw, 48px);
        font-family: var(--af-font-body);
        color: var(--af-text);
    }

    .af-testgrid__inner {
        max-width: 1000px;
        margin: 0 auto;
    }

    .af-testgrid__heading {
        font-family: var(--af-font-heading);
        font-size: clamp(24px, 3.5vw, 40px);
        font-weight: 700;
        text-align: center;
        margin-bottom: clamp(24px, 4vw, 48px);
    }

    .af-testgrid__grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: clamp(16px, 2.5vw, 24px);
    }

    .af-testgrid__card {
        background: var(--af-card-bg);
        border-radius: var(--af-radius);
        padding: clamp(24px, 3vw, 36px);
    }

    .af-testgrid__stars {
        color: var(--af-primary);
        font-size: clamp(18px, 1.4vw, 20px);
        margin-bottom: 16px;
        letter-spacing: 2px;
    }

    .af-testgrid__quote {
        font-family: var(--af-font-heading);
        font-size: clamp(18px, 1.8vw, 20px);
        font-weight: 400;
        font-style: italic;
        line-height: 1.6;
        margin-bottom: clamp(16px, 2.5vw, 24px);
    }

    .af-testgrid__author {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .af-testgrid__avatar {
        width: clamp(40px, 5vw, 48px);
        height: clamp(40px, 5vw, 48px);
        border-radius: 50%;
        object-fit: cover;
        background: var(--af-bg);
    }

    .af-testgrid__name {
        font-weight: 700;
        font-size: clamp(16px, 1.3vw, 18px);
    }

    .af-testgrid__role {
        font-size: clamp(16px, 1.2vw, 18px);
        color: var(--af-text-light);
    }

    @media (max-width: 640px) {
        .af-testgrid__grid { grid-template-columns: 1fr; }
    }

    .af-testgrid__cta {
        text-align: center;
        margin-top: clamp(24px, 4vw, 40px);
    }
    .af-testgrid__cta-btn {
        display: inline-block;
        background: var(--af-primary);
        color: #fff;
        font-family: var(--af-font-body);
        font-size: clamp(16px, 1.4vw, 18px);
        font-weight: 700;
        padding: 14px 36px;
        border-radius: 8px;
        text-decoration: none;
        transition: opacity 0.2s;
    }
    .af-testgrid__cta-btn:hover { opacity: 0.88; }

    @media (max-width: 768px) {
        .af-testgrid__cta-btn { width: 100%; text-align: center; box-sizing: border-box; }
    }

    *:focus-visible {
      outline: 3px solid var(--af-primary, #de6518);
      outline-offset: 3px;
      border-radius: 4px;
    }
</style>

<div class="af-testgrid">
    <div class="af-testgrid__inner">
        <h2 class="af-testgrid__heading">What our students say</h2>
        <div class="af-testgrid__grid">
            {% for item in items %}
            <div class="af-testgrid__card">
                <div class="af-testgrid__stars">★★★★★</div>
                <p class="af-testgrid__quote">"{{ item.quote }}"</p>
                <div class="af-testgrid__author">
                    {% if item.get('avatar_src') %}<img class="af-testgrid__avatar" src="{{ item.avatar_src|safe }}" alt="{{ item.avatar_alt }}">{% endif %}
                    <div>
                        <div class="af-testgrid__name">{{ item.name }}</div>
                        {% if item.get('role') %}<div class="af-testgrid__role">{{ item.role }}</div>{% endif %}
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
        <div class="af-testgrid__cta">
            <a class="af-testgrid__cta-btn" href="#form">Register for free →</a>
        </div>
    </div>
</div>
