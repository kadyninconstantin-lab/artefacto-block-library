{# accordion. items: [{question, answer, tag?}] — first item opens by default #}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Source+Serif+4:ital,wght@0,400;0,600;0,700;1,400&display=swap">
<!-- Artefacto Block: Accordion — раскрывающийся список (программа курса) -->
<style>

    .af-accordion {
        --af-primary: #de6518; --af-bg: #f4efe9; --af-card-bg: #ffffff;
        --af-text: #3b3b3b; --af-text-light: #4a4a4a; --af-radius: 12px;
        --af-font-heading: 'Source Serif 4', 'Georgia', serif;
        --af-font-body: 'Manrope', 'Helvetica Neue', sans-serif;
        background: var(--af-bg); padding: clamp(56px, 10vw, 120px) clamp(16px, 4vw, 48px);
        font-family: var(--af-font-body); color: var(--af-text);
    }
    .af-accordion__inner { max-width: 800px; margin: 0 auto; }
    .af-accordion__heading { font-family: var(--af-font-heading); font-size: clamp(24px, 3.5vw, 40px); font-weight: 700; text-align: center; margin-bottom: clamp(24px, 4vw, 48px); }
    .af-accordion__list { display: flex; flex-direction: column; gap: clamp(8px, 1.5vw, 12px); }
    .af-accordion__item { background: var(--af-card-bg); border-radius: var(--af-radius); overflow: hidden; }
    .af-accordion__item summary {
        padding: clamp(16px, 2.5vw, 24px); font-size: clamp(18px, 1.6vw, 20px); font-weight: 700;
        cursor: pointer; list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 16px; transition: color 0.2s;
    }
    .af-accordion__item summary::-webkit-details-marker { display: none; }
    .af-accordion__item summary::after { content: '+'; font-size: 24px; font-weight: 400; color: var(--af-primary); flex-shrink: 0; transition: transform 0.3s; }
    .af-accordion__item[open] summary::after { transform: rotate(45deg); }
    .af-accordion__item summary:hover { color: var(--af-primary); }
    .af-accordion__body { padding: 0 clamp(16px, 2.5vw, 24px) clamp(16px, 2.5vw, 24px); }
    .af-accordion__body p { font-size: clamp(18px, 1.5vw, 20px); line-height: 1.7; color: var(--af-text-light); margin-bottom: 8px; }
    .af-accordion__body p:last-child { margin-bottom: 0; }
    .af-accordion__tag { display: inline-block; font-size: 16px; font-weight: 700; color: var(--af-primary); background: rgba(222,101,24,0.1); padding: 2px 10px; border-radius: 10px; margin-bottom: 12px; }

    :focus-visible{outline:3px solid #de6518;outline-offset:3px;border-radius:4px;}
</style>
<div class="af-accordion">
    <div class="af-accordion__inner">
        <h2 class="af-accordion__heading">Course program</h2>
        <div class="af-accordion__list">
            {% for item in items %}
            <details class="af-accordion__item"{% if loop.first %} open{% endif %}>
                <summary>{{ item.question }}</summary>
                <div class="af-accordion__body">
                    {% if item.get('tag') %}<span class="af-accordion__tag">{{ item.tag }}</span>{% endif %}
                    {{ item.answer | safe }}
                </div>
            </details>
            {% endfor %}
        </div>
    </div>
</div>
